<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Exceção de cleartext restrita ao backend local de desenvolvimento.
         Ver res/xml/network_security_config.xml. Só existe em debug.

         Hoje isto é preparação, não requisito: o backoffice ainda roda sobre
         MockAdminDataSource e não faz requisição nenhuma. Está aqui para que a
         primeira implementação real de AdminDataSource sobre sinalacs_client não
         falhe com uma SocketException opaca de cleartext bloqueado. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
