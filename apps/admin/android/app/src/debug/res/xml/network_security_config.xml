<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP liberado APENAS em builds de debug e APENAS para o backend
    local. A partir do targetSdk 28 o Android bloqueia cleartext por padrão, e o
    Serverpod de desenvolvimento responde em http://10.0.2.2:8080 (o host visto
    de dentro do emulador Android).

    O manifest de src/main/ não é tocado: builds de release continuam sem
    nenhuma exceção de cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host da máquina de desenvolvimento, visto do emulador Android. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Execução em desktop/loopback. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
