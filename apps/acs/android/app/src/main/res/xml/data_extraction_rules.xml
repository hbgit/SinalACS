<?xml version="1.0" encoding="utf-8"?>
<!-- #152: nada do app do ACS vai para o backup na nuvem nem para a
     transferência entre aparelhos (Android 12+). Com targetSdk 31+,
     `android:allowBackup="false"` não desliga a transferência: sem estas
     regras, o banco SQLCipher da fila de visitas e as SharedPreferences (o
     WipeJournal da #81 e o EncryptedSharedPreferences do
     flutter_secure_storage) iriam para o aparelho novo, onde a chave do
     Keystore não existe. O resultado seria a recuperação de chave perdida ou
     um estado inconsistente. Antes da API 31 valem
     `android:fullBackupContent="false"` e `android:allowBackup="false"`.
     Mesma regra do app do paciente (#136). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
