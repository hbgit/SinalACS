<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Sem exceção de cleartext: o RPC é HTTPS na 443 desde o RNF04/L-08 e não
         há caminho em texto claro para liberar. A referência fica para que a
         decisão esteja onde alguém a procuraria — ver
         res/xml/network_security_config.xml. Só existe em debug. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
