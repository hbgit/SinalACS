# Coordenadas de toque das tomadas, em pixels de uma tela 1080x2400.
#
# Levantadas com ./discover.sh em 2026-09-10, num motorola edge 40 neo
# (1080x2400 nativo, densidade 400, Android 15). Se trocar de aparelho ou de
# densidade, RODE discover.sh de novo — estes números não são portáveis.
#
# Dumps e capturas de referência: video/out/discover/

# ---------- App do paciente (bloco 3) ----------
PATIENT_CPF_FIELD="540 1033"     # campo "CPF do paciente" (EditText vazio)
PATIENT_BIRTH_FIELD="540 1213"   # campo "Data de nascimento" (EditText vazio)
PATIENT_ENTER="540 1398"         # botão "Entrar sem senha"
                                 # PERIGO: "Escanear QR Code do ACS" fica 155 px abaixo,
                                 # em 540,1553 — dispara SnackBar de protótipo. Não errar o alvo.

# O botão de avanço MUDA DE POSIÇÃO a cada passo, porque fica abaixo da lista
# de opções e o passo 1 tem 4 opções enquanto os passos 2 e 3 têm 2.
PATIENT_Q1_BREATH="540 658"      # passo 1: "Falta de ar ou cansaço intenso"
PATIENT_NEXT_1="540 1263"        # passo 1: "Próxima pergunta" (4 opções acima)
PATIENT_Q2_SUDDEN="540 658"      # passo 2: "Sim, começou de repente"
PATIENT_NEXT_2="540 983"         # passo 2: "Próxima pergunta" (2 opções acima)
PATIENT_Q3_CHEST="540 658"       # passo 3: "Dor no peito ou sangramento"
PATIENT_CONCLUDE="540 983"       # passo 3: "Concluir triagem"

# Só de referência para o enquadramento do zoom na edição: é aqui que
# "Risco: Vermelho" é desenhado, e ele já está em tela ao ENTRAR no passo 3.
PATIENT_RISK_TEXT="540 1100"

# ---------- App do ACS (bloco 4) ----------
ACS_LOGIN="540 1268"             # "Entrar com credenciais" (matrícula/senha pré-preenchidas)

# Barra inferior de 5 destinos.
ACS_TAB_AREA="108 2300"          # "Área" — necessária: o app abre na Fila, não aqui
ACS_TAB_QUEUE="324 2300"         # "Fila"
ACS_TAB_MAP="540 2300"           # "Mapa"   — NÃO FILMAR (tela demonstrativa)
ACS_TAB_VISIT="756 2300"         # "Visita"
ACS_TAB_MORE="972 2300"          # "Mais"   — leva a Acionamento/Geofencing/Avisos, todos stubs

ACS_VISIT_OUTCOME="540 568"      # dropdown "Status do atendimento"
ACS_VISIT_NOTES="540 838"        # campo "Observações de campo" (EditText vazio)
ACS_VISIT_SAVE="436 1108"        # "Salvar e enfileirar sincronização"

# ---------- NÃO TOCAR: controles que queimam a demo ----------
# Cada um dispara SnackBar de "não integrado" ou abre uma tela errada.
#   392,748   Área  → "Atualizar dados da microárea"
#   545,818   Fila  → "Acionar SAMU / Atender"        (card vermelho da Maria)
#   545,1258  Fila  → "Iniciar rota de visita"        (card do João: abre o formulário
#                                                      com o nome da MARIA no topo)
#   545,1698  Fila  → "Ver dúvida / responder"        (card verde da Ana)
#   540,1553  Login do paciente → "Escanear QR Code do ACS"
